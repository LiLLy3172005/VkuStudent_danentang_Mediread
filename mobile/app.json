{
  "expo": {
    "name": "MediRead AI",
    "slug": "mediread-ai",
    "scheme": "mediread",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0B6B73",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.mediread.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Ứng dụng cần quyền sử dụng máy ảnh để chụp đơn thuốc, phiếu xét nghiệm và quét mã QR người thân.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần quyền truy cập thư viện ảnh để tải lên phiếu khám bệnh.",
        "NSMicrophoneUsageDescription": "Ứng dụng cần quyền sử dụng micro để hỗ trợ tương tác giọng nói.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "ai.mediread.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B6B73",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "MediRead AI",
      "shortName": "MediRead",
      "lang": "vi",
      "themeColor": "#0B6B73",
      "backgroundColor": "#F8FAFA",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần quyền sử dụng máy ảnh để chụp đơn thuốc và phiếu xét nghiệm."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần quyền truy cập thư viện ảnh để tải lên phiếu khám.",
          "cameraPermission": "Ứng dụng cần quyền sử dụng máy ảnh để chụp tài liệu y tế."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "412d8341-a78d-4647-b176-90c502cebf28"
      }
    },
    "owner": "luuly"
  }
}
