# =====================================================================
# MediRead AI - Production Environment Variables Example
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# =====================================================================

# Application Environment
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Supabase Managed Database & Auth Configuration
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.SET_YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.SET_YOUR_SERVICE_ROLE_KEY_IN_VAULT
SUPABASE_JWT_SECRET=SET_YOUR_SUPABASE_JWT_SECRET_MIN_32_CHARS

# Ollama LLM Service (Internal Network Only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096

# PaddleOCR Models Directory (Mounted or Local)
PADDLE_DET_DIR=C:\paddle_models\whl\det\en\en_PP-OCRv3_det_infer
PADDLE_REC_DIR=C:\paddle_models\whl\rec\latin\latin_PP-OCRv3_rec_infer
PADDLE_CLS_DIR=C:\paddle_models\whl\cls\ch_ppocr_mobile_v2.0_cls_infer
PADDLE_CPU_THREADS=2

# Security & Upload Limits
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp,image/heic

# Medical RAG
ENABLE_EXPLANATION_CACHE=false
CHROMA_PERSIST_DIR=D:\Do An Cuoi Ki\Thutudong\chroma_db
